<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_service_reference" model="ir.ui.view">
        <field name="name">account.move.form.service.reference</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="project_id" attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
                <field name="invoice_type" attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="guaranteed" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
